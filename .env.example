# MuaroTrack Mobile App — Environment Variables Example
# Copy this file to .env and fill in your values.
# DO NOT commit .env to git — it contains secrets.

# Backend API base URL
# - For local development with Android emulator: http://10.0.2.2:8000
# - For local development with iOS simulator: http://localhost:8000
# - For production: https://your-backend-url.onrender.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000